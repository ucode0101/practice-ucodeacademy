<div class="practice-page">
  <a href="/" class="back-link">← Back to exercises</a>
  <h1 class="practice-title">Add / Remove Elements</h1>
  <div class="practice-banner">    <ul><li>Click "Add Element" and verify a new Delete button appears in the DOM</li>
      <li>Count the number of Delete buttons using <code>findElements()</code></li>
      <li>Click a Delete button and verify it is removed from the DOM</li>
      <li>Add multiple elements and remove them one by one</li></ul>
  </div>
</div>
  <div class="example">
    <button class="btn btn-primary" onclick="addElement()">Add Element</button>
    <hr/>
    <div id="elements">
      <% if number_of_elements %>
        <% number_of_elements.times do |index| %>
          <button class="btn btn-danger added-manually" onclick='deleteElement()' style="margin:4px;">Delete</button>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
<script>
function addElement(){$('<button class="btn btn-danger added-manually" onclick="deleteElement()" style="margin:4px;">Delete</button>').appendTo('#elements');}
function deleteElement(){$('#elements button:first-child').remove();}
</script>

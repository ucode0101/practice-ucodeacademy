<style>
.content-row { display:flex; align-items:flex-start; gap:1rem; margin-bottom:1.2rem; }
.content-row img { width:80px; height:80px; border-radius:50%; object-fit:cover; flex-shrink:0; }
.content-row p { margin:0; font-size:0.9rem; color:#334155; line-height:1.6; }
</style>

<div class="practice-page">
  <a href="/" class="back-link">← Back to exercises</a>
  <h1 class="practice-title">Dynamic Content</h1>
  <div class="practice-banner"><ul>
    <li>Reload the page and verify the images and text change each time</li>
    <li>Append <code>?with_content=static</code> to pin content for consistent testing</li>
    <li>Assert a specific image or text value is present using <code>getText()</code></li>
  </ul></div>

  <p style="font-size:0.85rem; color:#64748b; margin-bottom:1rem;">
    To make content static: append <code>?with_content=static</code> or <a href='/dynamic_content?with_content=static'>click here</a>.
  </p>
  <hr style="margin-bottom:1rem;">

<% if @static_content %>
  <% [0,1,2].each do |i| %>
  <div class="content-row">
    <img src='/img/avatars/<%= @images[i] || @images[0] %>'>
    <p><%= i < 2 ? @copy[0] : @copy[0] %></p>
  </div>
  <% end %>
<% else %>
  <% @copy.each_with_index do |copy, i| %>
  <div class="content-row">
    <img src='/img/avatars/<%= @images[rand(@images.length)] %>'>
    <p><%= copy %></p>
  </div>
  <% end %>
<% end %>

</div>

<div class="practice-page">
  <a href="/" class="back-link">← Back to exercises</a>
  <h1 class="practice-title">Context Menu</h1>
  <div class="practice-banner"><ul>
    <li>Right-click the dashed box using <code>Actions.contextClick(element).perform()</code></li>
    <li>Handle the resulting JS alert with <code>driver.switchTo().alert().accept()</code></li>
    <li>Right-click the button and verify the alert message text</li>
  </ul></div>
<div class="example">
  
  <p>Context menu items are custom additions that appear in the right-click menu.</p>
  <p>Right-click in the box below. When you click it, it will trigger a JavaScript alert.</p>
  <div id='hot-spot' style="border-style: dashed; border-width: 5px; width: 250px; height: 150px;" oncontextmenu="displayMessage()">
  </div>
</div>

<br><br>

<div><h1 class="text-center"></h1>

  <div class="mt-4">
    <h4>Right click button</h4>
    <button id="rightClickBtn" type="button" class="btn btn-primary">Right Click Me</button>
  </div>

  <p id="rightClickMessage" style="display: none;">You have done a right click</p>
</div>

<script>
    function displayMessage() {
        window.alert('You selected a context menu');
    }

    document.addEventListener('DOMContentLoaded', (event) => {
        const button = document.getElementById('rightClickBtn');
        const message = document.getElementById('rightClickMessage');

        button.addEventListener('contextmenu', (e) => {
            e.preventDefault(); // Prevent the default context menu
            message.style.display = 'block'; // Show the message
        });
    });
</script>
</div>

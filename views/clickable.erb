<style>
  .button-container { display:inline-block; margin:5px; text-align:center; vertical-align:top; }
  .button-container button { display:block; padding:10px 20px; border:1px solid #2563eb; border-radius:5px; background:#2563eb; color:#fff; cursor:pointer; font-weight:600; transition:background 0.2s; }
  .button-container button:disabled { background:#cbd5e1; border-color:#cbd5e1; color:#64748b; cursor:not-allowed; }
  .countdown { margin-top:5px; font-size:13px; color:#ef4444; height:18px; }
  #initial-countdown { margin-top:1rem; font-size:0.9rem; color:#2563eb; font-weight:500; }
  #click-message { margin-top:0.5rem; font-size:0.9rem; color:#16a34a; font-weight:500; }
</style>

<div class="practice-page">
  <a href="/" class="back-link">← Back to exercises</a>
  <h1 class="practice-title">Clickable</h1>
  <div class="practice-banner"><ul>
    <li>Buttons are disabled for 5 seconds on page load — use <code>WebDriverWait</code> with <code>elementToBeClickable()</code></li>
    <li>After clicking a button, all buttons disable again for 5 seconds</li>
    <li>Assert the countdown text updates each second</li>
    <li>Verify the result message shows which button was clicked</li>
  </ul></div>

  <div class="button-container"><button data-button="1" disabled>Button 1</button><div class="countdown" data-countdown="1"></div></div>
  <div class="button-container"><button data-button="2" disabled>Button 2</button><div class="countdown" data-countdown="2"></div></div>
  <div class="button-container"><button data-button="3" disabled>Button 3</button><div class="countdown" data-countdown="3"></div></div>
  <div id="initial-countdown">Buttons will be clickable in 5 seconds...</div>
  <div id="click-message"></div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  var buttons = document.querySelectorAll('button');
  var initialCountdown = document.getElementById('initial-countdown');
  var clickMessage = document.getElementById('click-message');
  var initialSecondsLeft = 5;
  var initialInterval = setInterval(function() {
    initialCountdown.textContent = 'Buttons will be clickable in ' + initialSecondsLeft + ' seconds...';
    initialSecondsLeft--;
    if (initialSecondsLeft < 0) { clearInterval(initialInterval); initialCountdown.textContent = ''; buttons.forEach(function(b){ b.disabled = false; }); }
  }, 1000);
  buttons.forEach(function(button) {
    button.addEventListener('click', function() {
      if (this.disabled) return;
      buttons.forEach(function(btn){ btn.disabled = true; });
      var buttonNumber = this.getAttribute('data-button');
      var countdown = document.querySelector('.countdown[data-countdown="' + buttonNumber + '"]');
      var secondsLeft = 5;
      clickMessage.textContent = 'You clicked on Button ' + buttonNumber;
      countdown.textContent = 'Wait ' + secondsLeft + ' seconds...';
      var interval = setInterval(function() {
        secondsLeft--;
        countdown.textContent = 'Wait ' + secondsLeft + ' seconds...';
        if (secondsLeft < 0) { clearInterval(interval); buttons.forEach(function(b){ b.disabled = false; }); countdown.textContent = ''; clickMessage.textContent = ''; }
      }, 1000);
    });
  });
});
</script>

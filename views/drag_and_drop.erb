<style>
.columns { display:flex; gap:10px; margin:1rem 0; }
.column { height:150px; width:150px; border:2px solid #94a3b8; background:#e2e8f0; border-radius:8px; text-align:center; line-height:150px; font-size:2rem; font-weight:700; cursor:move; color:#1e293b; transition:background 0.2s; }
.column.over { border:2px dashed #2563EB; background:#dbeafe; }
#draggable { cursor:move; position:absolute; top:260px; left:50%; margin-left:-28px; width:56px; height:56px; border-radius:50%; background:#03a9f4; box-shadow:0 3px 10px rgba(0,0,0,0.2); }
#draggable.hollow { cursor:default; background:#e2e8f0; }
#droptarget { height:180px; width:180px; font-size:14px; border-radius:50%; text-align:center; line-height:180px; margin:0 auto; border:2px dashed #94a3b8; color:#64748b; }
.demo-section { height:280px; position:relative; }
.painted { background:#0ea5e9 !important; color:#fff; border-color:#0ea5e9 !important; }
</style>

<div class="practice-page">
  <a href="/" class="back-link">← Back to exercises</a>
  <h1 class="practice-title">Drag and Drop</h1>
  <div class="practice-banner">    <ul><li><strong>Box swap</strong> — drag column A onto column B to swap their positions</li>
      <li><strong>Circle drop</strong> — drag the small circle into the target zone</li>
      <li>Use <code>Actions.dragAndDrop(source, target).perform()</code> in Selenium</li>
      <li>In Playwright: <code>page.dragAndDrop(source, target)</code></li></ul>
  </div>
</div>

  <h5 style="font-weight:600; margin-bottom:0.3rem;">Exercise 1 — Swap Columns</h5>
  <p style="color:#64748b; font-size:0.9rem; margin-bottom:0.5rem;">Drag column A onto column B to swap them.</p>
  <div id="columns" class="columns">
    <div class="column" id="column-a" draggable="true"><header>A</header></div>
    <div class="column" id="column-b" draggable="true"><header>B</header></div>
  </div>

  <hr style="margin:1.5rem 0;">

  <h5 style="font-weight:600; margin-bottom:0.3rem;">Exercise 2 — Drop the Circle</h5>
  <p style="color:#64748b; font-size:0.9rem; margin-bottom:0.5rem;">Drag the small blue circle into the target zone.</p>
  <div class="demo-section">
    <div id="droptarget">Drop here</div>
    <div id="draggable" draggable="true"></div>
  </div>
</div>

<script>
// Exercise 1 — column swap
var dragSrcEl = null;
function handleDragStart(e) { this.style.opacity='0.4'; dragSrcEl=this; e.dataTransfer.effectAllowed='move'; e.dataTransfer.setData('text/html', this.innerHTML); }
function handleDragOver(e)  { e.preventDefault(); e.dataTransfer.dropEffect='move'; return false; }
function handleDragEnter(e) { this.classList.add('over'); }
function handleDragLeave(e) { this.classList.remove('over'); }
function handleDrop(e)      { e.stopPropagation(); if (dragSrcEl !== this) { dragSrcEl.innerHTML=this.innerHTML; this.innerHTML=e.dataTransfer.getData('text/html'); } return false; }
function handleDragEnd(e)   { document.querySelectorAll('#columns .column').forEach(function(c){ c.classList.remove('over'); c.style.opacity='1'; }); }
document.querySelectorAll('#columns .column').forEach(function(col) {
  col.addEventListener('dragstart', handleDragStart);
  col.addEventListener('dragenter', handleDragEnter);
  col.addEventListener('dragover',  handleDragOver);
  col.addEventListener('dragleave', handleDragLeave);
  col.addEventListener('drop',      handleDrop);
  col.addEventListener('dragend',   handleDragEnd);
});

// Exercise 2 — circle drop
var circle = document.getElementById('draggable');
var target = document.getElementById('droptarget');
circle.addEventListener('dragstart', function(e) { e.dataTransfer.setData('text','circle'); this.style.opacity='0.4'; });
circle.addEventListener('dragend',   function()  { this.style.opacity='1'; });
target.addEventListener('dragover',  function(e) { e.preventDefault(); this.classList.add('painted'); this.textContent='Drop it!'; });
target.addEventListener('dragleave', function()  { this.classList.remove('painted'); this.textContent='Drop here'; });
target.addEventListener('drop',      function(e) { e.preventDefault(); this.textContent='You did it! ✓'; this.classList.add('painted'); circle.style.display='none'; });
</script>

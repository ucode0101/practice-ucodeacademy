<div class="practice-page">
  <a href="/" class="back-link">← Back to exercises</a>
  <h1 class="practice-title">Multiple Buttons</h1>
  <div class="practice-banner"><ul>
    <li>Locate the correct button by its unique <code>id</code>, <code>name</code>, or visible text</li>
    <li>Note: Button 3–5 IDs are randomized on each page load — find them by text or relative locator</li>
    <li>Do NOT click <em>Don't click!</em> — it removes itself from the DOM</li>
    <li>Assert the <em>Result</em> message updates after each button click</li>
  </ul></div>

<script>
  function button1() { log('Clicked on button one!'); }
  function button2() { log('Clicked on button two!'); }
  function button3() { log('Clicked on button three!'); }
  function button4() { log('Clicked on button four!'); }
  function button5() { log('Clicked on button five!'); }
  function button6() { document.getElementsByName('button6')[0].remove(); log("Now it's gone!"); }
  function log(msg) { document.getElementById('result').innerHTML = msg; }
  window.onload = function() {
    var ids = ["btn_silver","button","b1","unity","buttoncheck","btn_quick","btn324","button","btnbtn","cool_button"];
    var ids2 = ["quick","three","b1","three","check","old","btn324","golden","btnbtn","cool"];
    document.getElementById('button3').id = "button_" + ids2[Math.floor(Math.random()*10)];
    document.getElementById('button4').id = ids2[Math.floor(Math.random()*10)] + "_button";
    document.getElementById('button5').id = ids[Math.floor(Math.random()*10)];
  }
</script>

  <p style="color:#64748b; font-size:0.9rem; margin-bottom:0.8rem;">Here are buttons with different attributes:</p>
  <div style="display:flex; gap:0.5rem; flex-wrap:wrap; margin-bottom:1rem;">
    <button class="btn btn-primary" onclick="button1()">Button 1</button>
    <button class="btn btn-primary" onclick="button2()" name="button2">Button 2</button>
    <button class="btn btn-primary" onclick="button3()" id="button3">Button 3</button>
    <button class="btn btn-primary" onclick="button4()" id="button4">Button 4</button>
    <button class="btn btn-primary" onclick="button5()" id="button5">Button 5</button>
    <button class="btn btn-danger" onclick="button6()" name="button6" id="disappearing_button">Don't click!</button>
  </div>
  <div style="padding:0.8rem 1rem; background:#f8fafc; border:1px solid #e2e8f0; border-radius:6px;">
    <strong>Result:</strong> <span id="result" style="color:#16a34a"></span>
  </div>
</div>

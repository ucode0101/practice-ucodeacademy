<script>
(function() {
  const searchInput  = document.getElementById('exercise-search');
  const clearBtn     = document.getElementById('clear-search');
  const filterTabs   = document.querySelectorAll('.filter-tab');
  const cards        = document.querySelectorAll('.exercise-card');
  const categories   = document.querySelectorAll('.category-block');
  const noResults    = document.getElementById('no-results');

  let activeFilter = 'all';

  function applyFilters() {
    const query = searchInput.value.trim().toLowerCase();
    clearBtn.style.display = query ? 'block' : 'none';

    let visibleCount = 0;

    categories.forEach(cat => {
      const catKey = cat.dataset.category;
      const catMatch = activeFilter === 'all' || activeFilter === catKey;
      let catVisible = false;

      cat.querySelectorAll('.exercise-card').forEach(card => {
        const name = (card.dataset.name || '').toLowerCase();
        const text = card.innerText.toLowerCase();
        const matchSearch = !query || name.includes(query) || text.includes(query);
        const show = catMatch && matchSearch;
        card.style.display = show ? '' : 'none';
        if (show) { catVisible = true; visibleCount++; }
      });

      cat.style.display = catVisible ? '' : 'none';
    });

    noResults.style.display = visibleCount === 0 ? 'block' : 'none';
  }

  searchInput.addEventListener('input', applyFilters);

  clearBtn.addEventListener('click', function() {
    searchInput.value = '';
    applyFilters();
    searchInput.focus();
  });

  filterTabs.forEach(tab => {
    tab.addEventListener('click', function() {
      filterTabs.forEach(t => t.classList.remove('active'));
      this.classList.add('active');
      activeFilter = this.dataset.filter;
      applyFilters();
    });
  });
})();
</script>

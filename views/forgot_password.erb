<div class="practice-page">
  <a href="/" class="back-link">← Back to exercises</a>
  <h1 class="practice-title">Forgot Password</h1>
  <div class="practice-banner"><ul>
    <li>Type an email into the field using <code>sendKeys()</code></li>
    <li>Click <em>Retrieve password</em> and verify a confirmation message appears</li>
    <li>Submit an empty form and verify validation prevents submission</li>
  </ul></div>
<div class="example">
  
  <h4 class="subheader"></h4>
  <form name="forgot_password" id="forgot_password" action="/forgot_password" method="post" >
     <div class="row">
      <div class="large-6 small-12 columns">
        <label for="email">E-mail</label>
        <input type="text" name="email" id="email" />
      </div>
    </div>
      <button id="form_submit" class="radius" type="submit"><i class="icon-2x icon-signin">Retrieve password</i></button>
  </form>
</div>
</div>

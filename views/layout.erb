<!DOCTYPE html>
<html lang="en">
<head>
  <script src="/js/vendor/298279967.js"></script>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>UI Automation Practice — U-Code Academy</title>
  <meta name="description" content="Practice real-world UI automation scenarios with 50+ interactive exercises. Built by U-Code Academy." />
  <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
  <link href="/css/app.css" rel="stylesheet">
  <link href="/css/font-awesome.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="/js/vendor/jquery-1.11.3.min.js"></script>
  <script src="/js/vendor/jquery-ui-1.11.4/jquery-ui.js"></script>
  <script src="/js/foundation/foundation.js"></script>
  <script src="/js/foundation/foundation.alerts.js"></script>
  <script>$(document).foundation();</script>
  <style>
    :root {
      --primary:   #2563EB;
      --primary-dark: #1D4ED8;
      --accent:    #7C3AED;
      --dark:      #0F172A;
      --surface:   #F8FAFC;
      --card-bg:   #FFFFFF;
      --border:    #E2E8F0;
      --text:      #1E293B;
      --muted:     #64748B;
    }

    * { box-sizing: border-box; }

    body {
      font-family: 'Inter', 'Arial', sans-serif;
      background: var(--surface);
      color: var(--text);
      margin: 0;
      padding: 0;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* ── NAVBAR ── */
    .site-nav {
      background: var(--dark);
      padding: 0 2rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 60px;
      position: sticky;
      top: 0;
      z-index: 1000;
      box-shadow: 0 2px 8px rgba(0,0,0,0.3);
    }
    .site-nav .brand {
      display: flex;
      align-items: center;
      gap: 10px;
      text-decoration: none;
      color: #fff;
      font-weight: 700;
      font-size: 1.1rem;
      letter-spacing: -0.3px;
    }
    .site-nav .brand img.nav-logo {
      height: 28px;
      width: auto;
      border-radius: 4px;
      object-fit: cover;
    }
    .site-nav .brand span.badge-logo {
      background: var(--primary);
      color: #fff;
      padding: 3px 9px;
      border-radius: 6px;
      font-size: 0.78rem;
      font-weight: 600;
      letter-spacing: 0.5px;
    }
    .site-nav nav a {
      color: #CBD5E1;
      text-decoration: none;
      font-size: 0.9rem;
      font-weight: 500;
      margin-left: 1.5rem;
      transition: color 0.2s;
    }
    .site-nav nav a:hover,
    .site-nav nav a.active { color: #fff; }

    /* ── MAIN CONTENT ── */
    .site-main {
      flex: 1;
      padding-bottom: 3rem;
    }

    /* ── FLASH ── */
    .flash-wrapper { max-width: 1200px; margin: 1rem auto 0; padding: 0 1.5rem; }

    /* ── PRACTICE PAGES SHARED ── */
    .practice-page { max-width: 860px; margin: 1.5rem auto; padding: 0 1.5rem; }
    .practice-banner {
      background: #EFF6FF;
      border-left: 4px solid #2563EB;
      border-radius: 0 8px 8px 0;
      padding: 0.45rem 1rem 0.45rem 1rem;
      margin-bottom: 1.2rem;
    }
    .practice-banner ul { margin: 0 0 0 1.1rem; padding: 0; font-size: 0.82rem; color: #334155; }
    .practice-banner ul li { margin-bottom: 0.1rem; line-height: 1.4; }
    .practice-title { font-size: 1.4rem; font-weight: 700; color: #0F172A; margin: 0 0 0.8rem; }
    .back-link { display: inline-flex; align-items: center; gap: 0.4rem; color: #2563EB; font-size: 0.82rem; text-decoration: none; margin-bottom: 0.8rem; }
    .back-link:hover { text-decoration: underline; }

    /* ── FOOTER ── */
    .site-footer {
      background: var(--dark);
      color: #94A3B8;
      text-align: center;
      padding: 1.4rem 1rem;
      font-size: 0.88rem;
    }
    .site-footer a { color: #60A5FA; text-decoration: none; }
    .site-footer a:hover { text-decoration: underline; }
  </style>
</head>
<body>

<!-- NAV -->
<header class="site-nav">
  <a href="/" class="brand">
    <img src="/img/ucode.jpg" alt="U-Code Academy" class="nav-logo">
    UI Automation Practice
  </a>
  <nav>
    <a href="/" class="active">Home</a>
    <a href="https://www.ucodeacademy.com/" target="_blank">Academy ↗</a>
  </nav>
</header>

<!-- FLASH MESSAGES -->
<div class="flash-wrapper">
  <% %w[notice error success].each do |type| %>
    <% if flash[type.to_sym] %>
      <div class="alert alert-<%= type %> alert-dismissible fade show mt-2" role="alert">
        <%= flash[type.to_sym] %>
        <button type="button" class="close" data-dismiss="alert">
          <span>&times;</span>
        </button>
      </div>
    <% end %>
  <% end %>
</div>

<!-- CONTENT -->
<main class="site-main">
  <%= yield %>
</main>

<!-- FOOTER -->
<footer class="site-footer">
  <p style="margin:0;">
    Built with ❤️ by <a href="https://www.ucodeacademy.com/" target="_blank">U-Code Academy</a>
    &nbsp;·&nbsp; 50+ Practice Exercises &nbsp;·&nbsp; © <%= Time.now.year %>
  </p>
</footer>

<script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.5.4/dist/umd/popper.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
</body>
</html>
